{
    "version": "7.2.5.81788",
    "description": "Firestorm Viewer, a third-party viewer for Second Life and OpenSim",
    "homepage": "https://www.firestormviewer.org/",
    "license": "LGPL-2.1-only",
    "architecture": {
        "64bit": {
            "url": "https://downloads.firestormviewer.org/release/windows/Phoenix-Firestorm-Releasex64_AVX2-7-2-5-81788_Setup.exe#/dl.7z",
            "hash": "faac17c3507e14f9a26f6cec2568df00b7e93a8af792522f72b4a4421236b0f0"
        }
    },
    "installer": {
        "script": [
            "# Remove the NSIS installer's own files left over from extraction",
            "Remove-Item -LiteralPath \"$dir\\`$PLUGINSDIR\", \"$dir\\[0]\" -Recurse -Force -ErrorAction SilentlyContinue"
        ]
    },
    "shortcuts": [
        [
            "Firestorm-Releasex64.exe",
            "Firestorm"
        ]
    ],
    "checkver": {
        "url": "https://api.github.com/repos/FirestormViewer/phoenix-firestorm/git/matching-refs/tags/Firestorm_Release_",
        "script": "& \"$(Split-Path $file)\\..\\scripts\\firestorm-latest.ps1\" -Channel Release -Days 7 -Token $GitHubToken",
        "regex": "^([\\d.]+)$"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://downloads.firestormviewer.org/release/windows/Phoenix-Firestorm-Releasex64_AVX2-$dashVersion_Setup.exe#/dl.7z"
            }
        }
    },
    "notes": [
        "This is the AVX2 build, which needs a CPU from roughly 2013 or later.",
        "Settings and chat logs live in %APPDATA%\\Firestorm_x64, so they are shared with any other Firestorm install on this PC."
    ]
}
